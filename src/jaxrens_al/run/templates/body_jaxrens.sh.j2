# Run a jaxrens nested-sampling job. The input file is a jaxrens YAML config
# (RootSpec); JaxrensNSSampler has already injected the trained model into
# ``backend.checkpoint_path`` and pointed ``output`` at this job's directory.
# Trajectories land as ``<out_file_prefix>.traj.extxyz`` (single run) or
# ``<out_file_prefix>.run{NN}.traj.extxyz`` (multi-replica) in the job cwd and
# are collected back by the SingleScriptTask.
#
# Self-detect --resume vs --force from a checkpoint left by an earlier
# attempt in this *same* directory, rather than baking the choice in at
# render time: this job may be a `--dependency=afternotok` auto-resume
# continuation of one that hit the cluster's walltime (see
# JaxrensNSSampler's job-chain submission), and every link of that chain
# runs this identical script. No checkpoint yet (a genuine first attempt,
# or one that died before its first checkpoint_interval) falls back to
# --force rather than a doomed --resume.
CONFIG_FILE={{ input_file }}
NS_PREFIX=$(python3 -c "import yaml; print(yaml.safe_load(open('$CONFIG_FILE'))['output']['out_file_prefix'])")
NS_WORKDIR=$(python3 -c "import yaml; print(yaml.safe_load(open('$CONFIG_FILE'))['output'].get('working_dir', '.'))")
if [ -f "${NS_WORKDIR}/${NS_PREFIX}.checkpoint.h5" ]; then
    RESUME_FLAG=--resume
else
    RESUME_FLAG=--force
fi
jaxrens run -c "$CONFIG_FILE" --n-gpus {{ n_cores }} $RESUME_FLAG

# Success marker checked by SingleScriptTask.finish_check on the host (see
# JaxrensNSSampler.get_sampled_configs) -- the wrapping job script's
# `set -euo pipefail` means this line is never reached if `jaxrens run`
# above failed, so its presence is a real completion signal, not just
# "the job ended" (which a killed/timed-out run also leaves partial
# .traj.extxyz files behind for).
echo "jaxrens run finished" > is_finished.info
